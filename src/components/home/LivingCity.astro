---
import LivingCityExperience from "./LivingCityExperience";

interface Props {
  appStoreUrl: string;
  playStoreUrl: string;
}

const { appStoreUrl, playStoreUrl } = Astro.props;
---

<LivingCityExperience
  variant="hero"
  appStoreUrl={appStoreUrl}
  playStoreUrl={playStoreUrl}
  client:load
/>
