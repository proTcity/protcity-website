---
import SEO from "../components/common/SEO.astro";
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import CookieConsent from "../components/common/CookieConsent.astro";
import GoogleAnalytics from "../components/common/GoogleAnalytics.astro";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  lang?: string;
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  robots?: string;
  bodyClass?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  type?: "website" | "article";
  feeds?: Array<{
    href: string;
    type: "application/rss+xml" | "application/feed+json";
    title: string;
  }>;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  lang = "it",
  title,
  description,
  canonicalPath,
  image,
  robots,
  bodyClass = "",
  ogTitle,
  ogDescription,
  twitterTitle,
  twitterDescription,
  type = "website",
  feeds = [],
  schema
} = Astro.props;

const skipLinkLabel = lang.toLowerCase().startsWith("en")
  ? "Skip to content"
  : "Vai al contenuto";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      robots={robots}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      twitterTitle={twitterTitle}
      twitterDescription={twitterDescription}
      type={type}
      lang={lang}
      schema={schema}
    />
    {feeds.map((feed) => (
      <link rel="alternate" type={feed.type} title={feed.title} href={feed.href} />
    ))}
    <GoogleAnalytics />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{skipLinkLabel}</a>
    <Header lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
    <script>
      import "../scripts/marketing.mjs";
    </script>
  </body>
</html>
