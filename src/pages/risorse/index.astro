---
import MainLayout from "../../layouts/MainLayout.astro";
import {
  getSeoResourcePath,
  seoHubPages,
  seoResourceBasePath
} from "../../data/seoHub";
import { site } from "../../data/site";
import { absoluteUrl } from "../../utils/seo";

const title = "Risposte sulla sicurezza urbana e sulla vita in città";
const description =
  "Risposte chiare e verificabili su sicurezza urbana, segnalazioni, percorsi, Comuni, turismo e strumenti proTcity, con fonti e limiti dichiarati.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${title} | ${site.name}`,
    description,
    url: absoluteUrl(seoResourceBasePath),
    inLanguage: "it-IT",
    isPartOf: {
      "@type": "WebSite",
      name: site.name,
      url: absoluteUrl("/")
    },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: seoHubPages.map((page, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: page.title,
        url: absoluteUrl(getSeoResourcePath(page.slug))
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "proTcity", item: absoluteUrl("/") },
      { "@type": "ListItem", position: 2, name: "Risorse", item: absoluteUrl(seoResourceBasePath) }
    ]
  }
];
---

<MainLayout
  title={title}
  description={description}
  canonicalPath={seoResourceBasePath}
  image="/images/features/optimized/city-pulse.webp"
  bodyClass="cinematic-site"
  schema={schema}
>
  <section class="cinematic-hero feature-hero feature-hero--seo-urban">
    <div class="cinematic-hero__media"></div>
    <div class="cinematic-hero__shade"></div>
    <div class="container cinematic-hero__content">
      <p class="eyebrow">Risposte proTcity</p>
      <h1>Domande reali. Risposte chiare, citabili e aggiornabili.</h1>
      <p class="cinematic-hero__lead">
        Un punto di accesso per persone, motori di ricerca e assistenti digitali: ogni risorsa affronta una domanda precisa, distingue i fatti dai suggerimenti e dichiara i propri limiti.
      </p>
      <div class="cinematic-hero__actions">
        <a class="glass-button glass-button--primary" href="/osservatorio">Apri l’Osservatorio</a>
        <a class="glass-button" href="/app">Scopri l’app</a>
      </div>
    </div>
  </section>

  <section class="cinematic-section" aria-labelledby="resource-title">
    <div class="container section-intro">
      <p class="cinematic-kicker">Conoscenza verificabile</p>
      <h2 id="resource-title">Scegli ciò che vuoi capire.</h2>
      <p>
        Le pagine sono scritte per rispondere prima alla domanda e poi approfondire. Per le informazioni del momento, la fonte centrale resta l’Osservatorio urbano.
      </p>
    </div>
    <div class="container seo-topic-grid">
      {seoHubPages.map((page) => (
        <a class="seo-topic-card" href={getSeoResourcePath(page.slug)}>
          <img src={page.image} alt="" loading="lazy" decoding="async" />
          <div>
            <span>{page.eyebrow}</span>
            <h3>{page.title}</h3>
            <p>{page.lead}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="cinematic-band" aria-labelledby="quality-title">
    <div class="container section-intro">
      <p class="cinematic-kicker">Come lavoriamo</p>
      <h2 id="quality-title">Fonti, date e responsabilità restano visibili.</h2>
      <p>
        Gli aggiornamenti urbani mostrano provenienza e data; i contenuti della community vengono distinti dalle comunicazioni verificate e dalle fonti istituzionali. Correzioni e segnalazioni possono essere inviate dai canali ufficiali proTcity.
      </p>
      <div class="cinematic-hero__actions">
        <a class="glass-button glass-button--primary" href="/osservatorio/metodo">Leggi il metodo editoriale</a>
        <a class="glass-button" href={`mailto:${site.emails.press}`}>Segnala una correzione</a>
      </div>
    </div>
  </section>
</MainLayout>
