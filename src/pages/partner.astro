---
import MainLayout from "../layouts/MainLayout.astro";

const studioBase = "https://studio.protcity.com";
const studioLogin = `${studioBase}/login`;

const audiences = [
  {
    marker: "01",
    eyebrow: "Comuni ed enti",
    title: "Informazioni istituzionali che arrivano nel contesto giusto.",
    description:
      "Un workspace verificato permette di coordinare avvisi, eventi, iniziative, contenuti territoriali e campagne informative con ruoli distinti, calendario e risultati aggregati.",
    points: ["Workspace e ruoli verificati", "Avvisi, eventi e contenuti", "Distribuzione territoriale controllata"],
    image: "/images/studio/categories/studio-enti-territorio.jpg",
    imageAlt: "Ente locale che coordina da Studio informazioni utili poi consultate dalla comunità nell’app proTcity"
  },
  {
    marker: "02",
    eyebrow: "Attività commerciali",
    title: "La presenza digitale incontra davvero il quartiere.",
    description:
      "Negozi, ristorazione, servizi e professionisti gestiscono sedi, contenuti, calendario e campagne locali, mantenendo separate le comunicazioni organiche da quelle promozionali.",
    points: ["Profilo e contenuti dell’attività", "Campagne con push comprese", "Insight e calendario condiviso"],
    image: "/images/studio/categories/studio-attivita-territorio.jpg",
    imageAlt: "Attività commerciale che usa Studio per comunicare tramite l’app con persone interessate nel territorio"
  },
  {
    marker: "03",
    eyebrow: "Strutture ricettive · GuestSafe",
    title: "L’accoglienza continua anche sul telefono dell’ospite.",
    description:
      "Hotel, B&B, residence e altre strutture accompagnano il soggiorno con accessi QR, comunicazioni, attività, assistenza, FAQ e una City Guide curata dalla reception.",
    points: ["Accessi e camere verificabili", "Attività, comunicazioni e inbox", "City Guide, FAQ e traduzioni"],
    image: "/images/studio/categories/studio-ospitalita-territorio.jpg",
    imageAlt: "Reception che usa GuestSafe in Studio mentre gli ospiti consultano servizi e City Guide nell’app proTcity"
  }
];

const ecosystemSteps = [
  {
    number: "01",
    title: "Accedi dal browser",
    copy: "Apri studio.protcity.com da computer, tablet o telefono. Registrazione, accesso, recupero password e gestione del workspace avvengono sul sito ufficiale Studio."
  },
  {
    number: "02",
    title: "Configura l’organizzazione",
    copy: "Indica la categoria, completa la verifica, assegna ruoli al team e scegli le funzioni coerenti con ente, attività commerciale o struttura ricettiva."
  },
  {
    number: "03",
    title: "Crea e distribuisci",
    copy: "Contenuti, eventi, campagne e servizi vengono preparati sul web; pubblico, area, gruppi, persone o camere sono selezionati prima della pubblicazione."
  },
  {
    number: "04",
    title: "L’app rende tutto utile sul territorio",
    copy: "Le persone consultano nell’app proTcity ciò che è stato pubblicato per loro e, quando previsto, ricevono notifiche pertinenti con accesso diretto al contenuto."
  }
];

const categoryJourneys = [
  {
    id: "enti",
    eyebrow: "Percorso 01 · Enti",
    title: "Dalla regia web all’informazione territoriale.",
    copy: "Studio offre agli enti una base ordinata per preparare e programmare informazioni destinate a cittadini, visitatori e comunità locali, con responsabilità e permessi leggibili.",
    image: "/images/studio/categories/studio-enti-territorio.jpg",
    video: "/videos/studio/categories/studio-enti.mp4",
    features: [
      "Avvisi, eventi, iniziative e contenuti territoriali",
      "Calendario editoriale e collaborazione per ruoli",
      "Destinatari, gruppi e livelli di visibilità espliciti",
      "Campagne informative e notifiche territoriali",
      "Insight aggregati e cronologia delle attività",
      "Percorsi dedicati per verifica, fatturazione e assistenza"
    ],
    impact: "Più continuità tra amministrazione e comunità: informazioni reperibili, tempestive e collocate nel punto o nell’area in cui diventano realmente utili."
  },
  {
    id: "attivita",
    eyebrow: "Percorso 02 · Attività commerciali",
    title: "Una presenza locale capace di generare relazione.",
    copy: "L’attività gestisce dal web la propria presenza, i contenuti e le campagne; l’app collega la comunicazione alle persone interessate e al contesto urbano, nel rispetto del consenso promozionale.",
    image: "/images/studio/categories/studio-attivita-territorio.jpg",
    video: "/videos/studio/categories/studio-attivita.mp4",
    features: [
      "Profilo organizzazione e una o più sedi",
      "Contenuti organici ed eventi programmabili",
      "Campagne locali con area e pubblico configurabili",
      "Push comprese nelle campagne disponibili",
      "Calendario, gruppi, destinatari e insight aggregati",
      "Piani, rinnovi e fatturazione gestiti in Studio"
    ],
    impact: "Più visibilità qualificata per il commercio locale e meno comunicazione dispersiva: il digitale sostiene visite, iniziative e vitalità economica del territorio."
  },
  {
    id: "ospitalita",
    eyebrow: "Percorso 03 · Strutture ricettive",
    title: "GuestSafe accompagna l’ospite prima, durante e fino al termine del soggiorno.",
    copy: "La reception prepara servizi e informazioni in Studio; l’ospite entra dall’app tramite QR e consenso, mantenendo i dati della struttura protetti fino all’attivazione del soggiorno.",
    image: "/images/studio/categories/studio-ospitalita-territorio.jpg",
    video: "/videos/studio/categories/studio-ospitalita.mp4",
    features: [
      "QR condivisi per la reception e accessi monouso",
      "Associazione volontaria e verificata della camera",
      "Attività e comunicazioni per tutti, più camere o una camera",
      "Inbox e notifiche per gli ospiti con soggiorno attivo",
      "FAQ ricercabili e City Guide con luoghi, utility e attività",
      "Immagini, video e traduzioni automatiche come servizio aggiuntivo"
    ],
    impact: "Un soggiorno più semplice e informato valorizza la struttura, distribuisce opportunità verso musei, trasporti, servizi e attività locali e migliora l’esperienza complessiva della destinazione."
  }
];

const impactAreas = [
  {
    title: "Informazione più utile",
    copy: "Il contenuto viene organizzato per luogo, tempo e pubblico, così le persone trovano più facilmente ciò che serve senza dipendere da messaggi generici."
  },
  {
    title: "Comunità più connessa",
    copy: "Enti, organizzazioni, attività e ospitalità condividono lo stesso ecosistema, mantenendo però ruoli, finalità e consensi distinti."
  },
  {
    title: "Economia locale più visibile",
    copy: "Campagne e City Guide possono trasformare l’attenzione digitale in visite, partecipazione a eventi e scoperta consapevole dei servizi del territorio."
  },
  {
    title: "Accoglienza più completa",
    copy: "Le strutture ricettive estendono il servizio oltre la reception e aiutano l’ospite a orientarsi, comunicare e vivere meglio la città."
  }
];

const faqs = [
  {
    question: "Che cos’è proTcity Studio?",
    answer: "proTcity Studio è il workspace web ufficiale con cui enti, attività commerciali e strutture ricettive verificate organizzano team, contenuti, campagne e servizi destinati all’ecosistema proTcity."
  },
  {
    question: "Studio sostituisce la precedente Console Partner?",
    answer: "Sì. La gestione operativa è stata concentrata in proTcity Studio. La vecchia console separata non è più una superficie operativa: il punto di accesso ufficiale è https://studio.protcity.com."
  },
  {
    question: "Posso usare le stesse credenziali sul sito e nell’app?",
    answer: "Sì. Lo stesso account proTcity può autenticarsi sia su Studio sia nell’app. Le funzioni disponibili dipendono dal ruolo assegnato, dalla verifica dell’organizzazione e dai servizi attivi. L’accesso all’app non attribuisce automaticamente permessi amministrativi in Studio."
  },
  {
    question: "Come comunicano Studio e l’app proTcity?",
    answer: "Gli operatori preparano e gestiscono i contenuti nel workspace web; l’app mostra alle persone soltanto ciò che è pubblico o autorizzato per il loro account, la loro area, il gruppo o il soggiorno attivo."
  },
  {
    question: "Le notifiche sono obbligatorie?",
    answer: "No. Le notifiche richiedono il consenso del dispositivo e, per i messaggi promozionali, il consenso dedicato. I contenuti autorizzati restano consultabili nelle relative sezioni dell’app anche quando le push sono disattivate."
  },
  {
    question: "Studio gestisce emergenze o procedimenti amministrativi?",
    answer: "No. Studio non sostituisce il 112, centrali operative, protocolli, denunce, servizi di emergenza o software istituzionali di gestione dei procedimenti."
  }
];

const capabilities = [
  {
    title: "Crea e programma",
    copy: "Prepara contenuti, eventi e campagne; pubblicali subito oppure scegli data e ora dal Calendario Studio."
  },
  {
    title: "Scegli i destinatari",
    copy: "Pubblica per tutti, per gli iscritti, per gruppi personalizzati o per singole persone che hanno accettato l’invito."
  },
  {
    title: "Controlla la visibilità",
    copy: "Distingui contenuti pubblici, pin con dettaglio riservato e comunicazioni completamente riservate ai destinatari."
  },
  {
    title: "Invia notifiche pertinenti",
    copy: "Abbina la push al pubblico selezionato, rispettando adesioni, consensi e limiti previsti dal piano."
  },
  {
    title: "Lavora con ruoli separati",
    copy: "Owner, amministratori, editor, analisti, responsabili della fatturazione e viewer operano con permessi coerenti."
  },
  {
    title: "Leggi risultati aggregati",
    copy: "Consulta indicatori sui contenuti e sulle campagne senza esporre l’identità delle singole persone raggiunte."
  }
];

const distributionModes = [
  {
    title: "Pubblico sulla mappa",
    badge: "Visibilità ampia",
    copy: "Pin e contenuto sono visibili e apribili da tutte le persone nell’area prevista."
  },
  {
    title: "Pin pubblico, dettaglio riservato",
    badge: "Accesso controllato",
    copy: "Il pin comunica che esiste un aggiornamento; il dettaglio resta disponibile soltanto ai destinatari autorizzati."
  },
  {
    title: "Completamente riservato",
    badge: "Solo destinatari",
    copy: "Pin, contenuto e notifica sono visibili esclusivamente alle persone o ai gruppi selezionati."
  }
];

const planFamilies = [
  {
    title: "Studio Presenza",
    copy: "Per iniziare con una presenza essenziale e una gestione editoriale semplice."
  },
  {
    title: "Studio Local, Plus e Network",
    copy: "Per attività e organizzazioni che richiedono più sedi, collaboratori, campagne e profondità analitica."
  },
  {
    title: "Studio Enti ed Enterprise",
    copy: "Per Comuni, enti e realtà strutturate con esigenze amministrative, territoriali e operative dedicate."
  }
];

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "proTcity Studio per enti, attività commerciali e strutture ricettive",
    url: "https://www.protcity.com/partner",
    description:
      "Scopri proTcity Studio, il workspace web collegato all’app per enti, attività commerciali e strutture ricettive con GuestSafe.",
    isPartOf: {
      "@type": "WebSite",
      name: "proTcity",
      url: "https://www.protcity.com"
    },
    about: {
      "@type": "SoftwareApplication",
      name: "proTcity Studio",
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      url: studioBase
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer }
    }))
  }
];
---

<MainLayout
  title="proTcity Studio per enti, attività commerciali e strutture ricettive"
  description="Scopri come proTcity Studio collega il lavoro sul web all’app: funzioni per enti, attività commerciali e strutture ricettive con GuestSafe."
  canonicalPath="/partner"
  image="/images/studio/studio-dashboard.webp"
  bodyClass="cinematic-site studio-partner-site"
  schema={structuredData}
>
  <section class="studio-hero">
    <div class="studio-hero__aurora" aria-hidden="true"></div>
    <div class="studio-hero__grid" aria-hidden="true"></div>
    <div class="container studio-hero__layout">
      <div class="studio-hero__copy">
        <p class="studio-kicker"><span></span> proTcity Studio</p>
        <h1>Dal web all’app. Dall’organizzazione al territorio.</h1>
        <p class="studio-hero__lead">
          Studio è il punto operativo ufficiale per enti, attività commerciali e strutture ricettive.
          Dal browser organizzi il lavoro; nell’app proTcity informazioni, campagne e servizi
          raggiungono cittadini, clienti e ospiti nel contesto in cui diventano utili.
        </p>
        <div class="studio-hero__actions">
          <a class="studio-button studio-button--primary" href={`${studioBase}/registrazione`}>
            Registrati su Studio <span aria-hidden="true">↗</span>
          </a>
          <a class="studio-button studio-button--ghost" href={studioLogin}>Accedi a Studio</a>
          <a class="studio-button studio-button--ghost" href="#come-funziona">Come funziona</a>
        </div>
        <ul class="studio-hero__trust" aria-label="Caratteristiche principali">
          <li>Un solo account proTcity</li>
          <li>Ruoli e organizzazioni verificati</li>
          <li>Web e app collegati</li>
        </ul>
      </div>

      <div class="studio-hero__visual" aria-label="Anteprima reale della dashboard proTcity Studio">
        <div class="studio-window studio-window--hero">
          <div class="studio-window__bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <small>studio.protcity.com</small>
          </div>
          <img
            src="/images/studio/studio-dashboard.webp"
            alt="Dashboard reale di proTcity Studio con contenuti, campagne e indicatori aggregati"
            width="628"
            height="484"
            fetchpriority="high"
          />
        </div>
        <div class="studio-float-card studio-float-card--calendar" aria-hidden="true">
          <span>STUDIO WEB</span>
          <strong>Crea, organizza e misura</strong>
        </div>
        <div class="studio-float-card studio-float-card--audience" aria-hidden="true">
          <span>APP PROTCITY</span>
          <strong>Informa, coinvolgi e accompagna</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="studio-signal" aria-label="Valori di Studio">
    <div class="container studio-signal__grid">
      <div><strong>Un sito operativo</strong><span>accessibile da ogni browser moderno</span></div>
      <div><strong>Una sola identità</strong><span>stesso account sul web e nell’app</span></div>
      <div><strong>Tre percorsi dedicati</strong><span>Enti, attività e ospitalità</span></div>
      <div><strong>Un impatto concreto</strong><span>informazione, economia e comunità</span></div>
    </div>
  </section>

  <section id="come-funziona" class="studio-section studio-ecosystem">
    <div class="container">
      <header class="studio-heading">
        <p class="studio-kicker"><span></span> Un sistema, due esperienze collegate</p>
        <h2>Studio è la regia web. L’app porta il valore alle persone.</h2>
        <p>
          Gli operatori lavorano in sicurezza su <a href={studioBase}>studio.protcity.com</a>;
          cittadini, clienti e ospiti usano l’app proTcity. Le due superfici condividono lo stesso
          ecosistema, ma mostrano funzioni e dati coerenti con il ruolo di chi accede.
        </p>
      </header>
      <div class="studio-ecosystem__steps">
        {ecosystemSteps.map((step) => (
          <article>
            <span>{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
      <div class="studio-account-note">
        <div class="studio-account-note__badge" aria-hidden="true">ID</div>
        <div>
          <strong>Le credenziali sono le stesse.</strong>
          <p>
            L’email e la password dell’account proTcity possono essere usate sia su Studio sia nell’app.
            I permessi amministrativi non sono automatici: dipendono dal ruolo assegnato nel workspace,
            dalla verifica dell’organizzazione e dai servizi effettivamente attivi.
          </p>
        </div>
        <a class="studio-text-link" href={studioLogin}>Vai all’accesso ufficiale <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="studio-section studio-audiences">
    <div class="container">
      <header class="studio-heading">
        <p class="studio-kicker"><span></span> Tre categorie, strumenti dedicati</p>
        <h2>Ogni organizzazione trova il proprio percorso operativo.</h2>
        <p>
          La base tecnologica è comune; funzioni, piani, destinatari e flussi restano distinti per evitare
          sovrapposizioni tra comunicazione istituzionale, attività economiche e accoglienza.
        </p>
      </header>
      <div class="studio-audience-grid">
        {audiences.map((audience) => (
          <article class="studio-audience-card">
            <img src={audience.image} alt={audience.imageAlt} width="1600" height="900" loading="lazy" />
            <div class="studio-audience-card__number">{audience.marker}</div>
            <p class="studio-audience-card__eyebrow">{audience.eyebrow}</p>
            <h3>{audience.title}</h3>
            <p>{audience.description}</p>
            <ul>
              {audience.points.map((point) => <li>{point}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="studio-section studio-product-tour">
    <div class="container">
      <header class="studio-heading studio-heading--center">
        <p class="studio-kicker"><span></span> Studio in movimento</p>
        <h2>Dall’idea alla pubblicazione, senza passaggi dispersi.</h2>
        <p>
          Una panoramica reale del workspace: pianificazione, pubblico, distribuzione e lettura dei risultati.
        </p>
      </header>

      <div class="studio-video-shell">
        <div class="studio-video-shell__glow" aria-hidden="true"></div>
        <div class="studio-window__bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <small>proTcity Studio · panoramica</small>
        </div>
        <video
          data-studio-demo
          autoplay
          controls
          muted
          loop
          playsinline
          preload="metadata"
          poster="/images/video-posters/studio/studio-overview.webp"
          aria-label="Video dimostrativo delle principali funzioni di proTcity Studio"
        >
          <source src="/videos/studio/studio-overview.mp4" type="video/mp4" />
          Il browser non supporta il video. Puoi consultare le schermate illustrate nella pagina.
        </video>
        <div class="studio-video-shell__caption">
          <span>01 Calendario</span>
          <span>02 Destinatari</span>
          <span>03 Distribuzione</span>
          <span>04 Insight</span>
        </div>
      </div>
    </div>
  </section>

  <section class="studio-section studio-category-tours">
    <div class="container">
      <header class="studio-heading studio-heading--center">
        <p class="studio-kicker"><span></span> Dimostrazioni per categoria</p>
        <h2>Tre modi diversi di trasformare il digitale in servizio.</h2>
        <p>
          Ogni percorso mostra il collegamento tra ciò che l’organizzazione prepara in Studio,
          ciò che compare nell’app e il risultato prodotto sul territorio.
        </p>
      </header>

      {categoryJourneys.map((journey, index) => (
        <article id={journey.id} class:list={["studio-category-tour", index % 2 === 1 && "studio-category-tour--reverse"]}>
          <div class="studio-category-tour__media">
            <video
              controls
              muted
              loop
              playsinline
              preload="metadata"
              poster={journey.image}
              aria-label={`Video dimostrativo di proTcity Studio per ${journey.eyebrow}`}
            >
              <source src={journey.video} type="video/mp4" />
              Il browser non supporta il video. Le stesse informazioni sono disponibili nel testo accanto.
            </video>
          </div>
          <div class="studio-category-tour__copy">
            <p class="studio-category-tour__eyebrow">{journey.eyebrow}</p>
            <h3>{journey.title}</h3>
            <p>{journey.copy}</p>
            <ul>
              {journey.features.map((feature) => <li>{feature}</li>)}
            </ul>
            <div class="studio-category-tour__impact">
              <span>Impatto sul territorio e sulla comunità</span>
              <p>{journey.impact}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="studio-section studio-capabilities">
    <div class="container studio-capabilities__layout">
      <div class="studio-capabilities__intro">
        <p class="studio-kicker"><span></span> Funzioni operative</p>
        <h2>Tutto ciò che serve per comunicare meglio. Niente rumore in più.</h2>
        <p>
          Ogni funzione nasce per ridurre passaggi manuali e rendere chiara la relazione tra contenuto,
          destinatari, visibilità e risultato.
        </p>
        <a class="studio-text-link" href={`${studioBase}/funzionalita`}>
          Esplora tutte le funzionalità <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="studio-capability-grid">
        {capabilities.map((capability, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <h3>{capability.title}</h3>
            <p>{capability.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="studio-section studio-workflow">
    <div class="container">
      <header class="studio-heading">
        <p class="studio-kicker"><span></span> Un flusso leggibile</p>
        <h2>Organizza. Pubblica. Misura.</h2>
      </header>

      <article class="studio-showcase">
        <div class="studio-showcase__copy">
          <span class="studio-showcase__step">01 · Organizza</span>
          <h3>Il Calendario Studio rende visibile ogni attività editoriale.</h3>
          <p>
            Contenuti e campagne programmate o già attive sono raccolti in una vista mensile ordinata.
            Gli elementi dello stesso giorno restano consultabili senza sovrapposizioni.
          </p>
          <ul><li>Programmazione per data e ora</li><li>Vista unificata di contenuti e campagne</li><li>Accesso rapido ai dettagli</li></ul>
        </div>
        <figure class="studio-window">
          <div class="studio-window__bar" aria-hidden="true"><span></span><span></span><span></span><small>Calendario Studio</small></div>
          <img src="/images/studio/studio-calendar.webp" alt="Calendario reale di proTcity Studio" width="1042" height="654" loading="lazy" />
        </figure>
      </article>

      <article class="studio-showcase studio-showcase--reverse">
        <div class="studio-showcase__copy">
          <span class="studio-showcase__step">02 · Seleziona</span>
          <h3>Destinatari e gruppi restano sotto il controllo dell’organizzazione.</h3>
          <p>
            Gli inviti raggiungono account proTcity identificati in modo puntuale. La persona decide se aderire
            e può revocare la propria scelta; il consenso promozionale rimane separato.
          </p>
          <ul><li>Inviti con accettazione nell’app</li><li>Gruppi personalizzati e gestibili</li><li>Adesioni e consensi distinti</li></ul>
        </div>
        <figure class="studio-window">
