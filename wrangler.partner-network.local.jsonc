{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protcity-partner-network-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "drop-trailing-slash", "not_found_handling": "404-page"},
  "vars": {"PARTNER_INTAKE_ENABLED": "true", "PARTNER_INTAKE_LOCAL_ONLY": "true", "PARTNER_FORM_SECRET": "synthetic-local-only-not-a-production-secret"},
  "d1_databases": [{"binding": "PARTNER_APPLICATIONS_DB", "database_name": "partner-applications-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "PARTNER_RATE_LIMITER", "namespace_id": "10001", "simple": {"limit": 5, "period": 60}}],
  "triggers": {"crons": ["17 3 * * *"]}
}
